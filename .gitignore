# Segredos
.env
.env.*
!.env.example
*.key
*.pem

# Dependências
node_modules/

# Mídia gerada
out/*
!out/.gitkeep
public/assets/*.mp4
public/assets/*.png
public/assets/*.jpg
public/assets/*.webp

# Suas fotos/imagens de base (nunca sobem para o GitHub público)
entradas/*
!entradas/.gitkeep

# Gerado automaticamente a partir de prompts/
src/scenes.generated.ts

# Roteiros confidenciais (nunca sobem para o GitHub público)
prompts/privados/*
!prompts/privados/.gitkeep

# Sistema
.DS_Store
